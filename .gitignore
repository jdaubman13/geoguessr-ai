*.index
*.faiss

# ── HuggingFace & torch cache ─────────────────────────────────────────────────
.cache/
~/.cache/huggingface/
backend/.cache/

# ── Uploads (user images should never be committed) ───────────────────────────
backend/uploads/
backend/tmp/
*.jpg
*.jpeg
*.png
*.webp
*.gif

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
.npm/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Database ──────────────────────────────────────────────────────────────────
*.sqlite
*.db
*.sql.gz
pgdata/

